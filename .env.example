# Copy this to .env and fill in your keys
# NEVER commit .env — it is gitignored

# Which LLM provider to use for the parsing pipeline.
# - "anthropic" → single-call pipeline using Claude (recommended, default)
# - "gemini"    → legacy 3-call pipeline (parser → resolver → verifier)
VITE_LLM_PROVIDER=anthropic

# Required when VITE_LLM_PROVIDER=anthropic
VITE_ANTHROPIC_API_KEY=

# Required when VITE_LLM_PROVIDER=gemini
VITE_GEMINI_API_KEY=

VITE_OPENAI_API_KEY=
